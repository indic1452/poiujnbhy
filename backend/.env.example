# ------------------------------------------------------------------
# Пример конфигурации. Скопируйте в .env и отредактируйте под себя.
# ------------------------------------------------------------------

# --- База данных (PostgreSQL, async-драйвер asyncpg) ---
DATABASE_URL=postgresql+asyncpg://newsuser:newspass@localhost:5432/newsdb

# --- Режим источников ---
# live     — тянуть реальные ленты из сети (нужен доступ к новостным сайтам)
# fixtures — читать сохранённые примеры из backend/tests/fixtures (для локальной разработки/демо)
SOURCE_MODE=live

# Путь к YAML со списком источников
SOURCES_FILE=sources.yaml

# --- Локальная модель ИИ (текст: обобщение + перевод) ---
# ollama | mock | nllb
SUMMARIZER_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
MODEL=qwen3:8b

# --- Локальная vision-модель (анализ фото/кадра видео) ---
# ollama | mock
VISION_BACKEND=ollama
VISION_MODEL=qwen2.5vl:7b

# --- Медиа ---
# image — качать фото и постеры видео (по умолчанию)
# all   — качать ещё и сами видеофайлы (много диска)
# off   — не качать, хранить только ссылки
MEDIA_DOWNLOAD=image
MEDIA_DIR=media
MAX_MEDIA_BYTES=15000000

# --- Планировщик ---
POLL_INTERVAL_SECONDS=600
INGEST_ON_START=false

# Создавать таблицы при старте (для быстрого демо без alembic). В проде — false.
AUTO_CREATE_TABLES=false

# --- Кластеризация / релевантность ---
CLUSTER_SIMILARITY=82
CLUSTER_WINDOW_HOURS=48

# --- Геокодирование (карта событий) ---
GEOCODER_ENABLED=true
GEO_CONFIDENCE_FLOOR=0.5
# Полный газеттир GeoNames (соберите scripts/build_gazetteer.py, затем укажите путь;
# либо положите результат в backend/data/gazetteer_full.csv — подхватится сам)
# GAZETTEER_FULL_CSV=data/gazetteer_full.csv
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors, GeoNames (CC BY 4.0)

# --- Telegram (опционально, для авторизованного доступа через Telethon) ---
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=tg.session

# --- CORS (адрес фронтенда для разработки) ---
CORS_ORIGINS=http://localhost:5173
