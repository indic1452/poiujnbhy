# ---------------------------------------------------------------------------
# Настройки установки. Скопируйте и заполните:
#     cp .env.example /etc/reportgen/reportgen.env
#     chown root:reportgen /etc/reportgen/reportgen.env && chmod 640 …
#
# Формат — KEY=VALUE без экспорта: файл подходит и для systemd
# (EnvironmentFile=), и для docker compose (env_file:), и для `set -a; . .env`.
# Значения с пробелами и с решёткой берите в двойные кавычки — их снимают все
# три потребителя, а вот bash без кавычек на строке со пробелом сломается.
# Каждая переменная соответствует полю Settings из src/reportgen/config.py:
# REPORTGEN_<ИМЯ_ПОЛЯ>. Пустое значение = «как по умолчанию».
# Значения ниже подобраны под сервер заказчика: RTX 4080 16 ГБ, Xeon E5-2680
# (14 ядер), 64 ГБ ОЗУ, изолированный контур (см. docs/02 р. 2.2 и docs/10).
# ---------------------------------------------------------------------------

# --- пути ------------------------------------------------------------------
# Корень изменяемых данных. Достаточно задать только его: база, библиотека,
# загрузки и экспорты по умолчанию выводятся из него. Каталог должен
# принадлежать пользователю reportgen.
REPORTGEN_DATA_DIR=/var/lib/reportgen

# Ниже — переопределения на случай, когда данные разнесены по томам
# (например, библиотека на большом HDD, база на NVMe). Пусто = data_dir/<имя>.
REPORTGEN_DB_PATH=
REPORTGEN_LIBRARY_DIR=
REPORTGEN_UPLOAD_DIR=
REPORTGEN_EXPORT_DIR=

# Шаблоны-планы отчётов и глоссарий. Их правит старший инженер, поэтому они
# лежат рядом с установкой, а не внутри пакета.
REPORTGEN_TEMPLATES_DIR=/opt/reportgen/templates
REPORTGEN_GLOSSARY_PATH=/opt/reportgen/templates/glossary.json

# Фирменный DOCX-шаблон (стили, колонтитулы, логотип). Пусто — экспорт
# оформляется стилями по умолчанию.
REPORTGEN_DOCX_TEMPLATE=

# Необязательный JSON-файл настроек; переменные окружения важнее него.
# REPORTGEN_CONFIG=/etc/reportgen/settings.json

# --- языковая модель --------------------------------------------------------
# stub — офлайн-заглушка без сервера (проверка конвейера, тесты);
# openai — любой OpenAI-совместимый локальный сервер: llama.cpp, vLLM, Ollama.
REPORTGEN_LLM_KIND=openai

# llama-server с хоста. В docker compose — http://llama-server:8000/v1.
REPORTGEN_LLM_BASE_URL=http://127.0.0.1:8000/v1

# Имя модели в ответах сервера. llama.cpp принимает любое, но пишите реальное:
# оно попадает в служебный блок отчёта (инвариант воспроизводимости 1.4.3).
REPORTGEN_LLM_MODEL=gpt-oss-20b-mxfp4

# Локальный сервер ключ не проверяет; наружу контура ничего не уходит.
REPORTGEN_LLM_API_KEY=not-needed

# Таймаут одного запроса, с. Отчёт генерируется посекционно; на 30B с выгрузкой
# экспертов в ОЗУ секция занимает до 1.5 мин, 600 с — с большим запасом.
REPORTGEN_LLM_TIMEOUT=600

# Seed. Фиксированный = воспроизводимая генерация. Пусто — случайный.
REPORTGEN_LLM_SEED=0

# Температура. Для технического текста больше 0.3 не ставьте.
REPORTGEN_LLM_TEMPERATURE=0.2

# Сколько секций разрешено считать одновременно. Держите равным --parallel
# у llama-server (в deploy/llama-server.service это 2): больше слотов на
# 16 ГБ VRAM = меньше контекста на слот.
REPORTGEN_LLM_PARALLEL_SECTIONS=2

# --- эмбеддинги (плотный поиск) --------------------------------------------
# Выключено — работает лексический поиск FTS5, этого достаточно для старта.
# Включайте, когда рядом поднят сервер bge-m3 и построены векторы:
#   reportgen embed
REPORTGEN_EMBED_ENABLED=false
REPORTGEN_EMBED_BASE_URL=http://127.0.0.1:8001/v1
REPORTGEN_EMBED_MODEL=bge-m3
REPORTGEN_EMBED_API_KEY=not-needed
# Размер пакета. На CPU (Broadwell, без AVX-512) больше 16 смысла не даёт.
REPORTGEN_EMBED_BATCH=16
REPORTGEN_EMBED_TIMEOUT=120

# --- реранкер ---------------------------------------------------------------
# Самый выгодный по соотношению «усилие/качество» компонент поиска (docs/02
# р. 2.5): BM25 даёт 50 кандидатов, реранкер оставляет 6.
REPORTGEN_RERANK_ENABLED=false
REPORTGEN_RERANK_BASE_URL=http://127.0.0.1:8002/v1
REPORTGEN_RERANK_MODEL=bge-reranker-v2-m3
REPORTGEN_RERANK_API_KEY=not-needed
REPORTGEN_RERANK_TIMEOUT=120

# --- поиск ------------------------------------------------------------------
# Сколько кандидатов отбирает первый этап поиска (BM25 + векторы).
REPORTGEN_RETRIEVAL_CANDIDATES=60
# Сколько фрагментов уходит в промпт РАЗДЕЛА ОТЧЁТА. Больше 8 опасно: факты
# из факт-пакета «тонут» в цитатах, и модель начинает писать по источникам,
# а не по измерениям.
REPORTGEN_RETRIEVAL_TOP_K=8

# --- развёрнутость ответа помощника -----------------------------------------
# У разговора материал ограничен только вопросом, поэтому фрагментов берём
# больше, чем для отчёта, и каждый — целиком.
REPORTGEN_ASSISTANT_TOP_K=12
REPORTGEN_ASSISTANT_SOURCE_CHARS=2200
# Жёсткий потолок на весь материал в знаках. Считается от окна модели:
# llama-server с -c 32768 --parallel 2 даёт 16384 токена на разговор, из них
# 4000 уходит на ответ. Переполнение llama.cpp обрабатывает молча — выбрасывает
# начало промпта вместе с системной инструкцией, и модель перестаёт ставить
# ссылки на источники. Снижаете контекст модели — снижайте и это число.
REPORTGEN_ASSISTANT_CONTEXT_CHARS=26000
# Соседние фрагменты того же документа: таблица параметров редко умещается
# в один кусок. 0 — выключить.
REPORTGEN_ASSISTANT_NEIGHBOURS=1
REPORTGEN_ASSISTANT_NEIGHBOUR_TOP=4
# Оглавление документов в промпте: модель видит, что ещё есть в документе.
REPORTGEN_ASSISTANT_OUTLINES=1
REPORTGEN_ASSISTANT_MAX_TOKENS=4000
REPORTGEN_ASSISTANT_TARGET_WORDS=500

# --- оформление -------------------------------------------------------------
# Название компании и подпись отдела: попадают в шапку интерфейса и в
# колонтитул DOCX. Пишите так, как должно выглядеть в документе заказчику.
REPORTGEN_BRAND_NAME="Экспертиза связи"
REPORTGEN_BRAND_SUBTITLE="Подготовка технических отчётов"

# Акцентный цвет интерфейса, HEX.
REPORTGEN_BRAND_ACCENT="#2563eb"

# Логотип (PNG или SVG). Пусто — интерфейс обойдётся без него.
REPORTGEN_BRAND_LOGO=/opt/reportgen/templates/logo.png

# Строка колонтитула отчёта: реквизиты, гриф, номер лицензии — что требует
# ваш регламент оформления. Пусто — колонтитул не добавляется.
REPORTGEN_REPORT_FOOTER=""

# --- веб --------------------------------------------------------------------
# Слушать только петлевой интерфейс: наружу смотрит nginx с TLS
# (deploy/nginx.conf). В контейнере ставьте 0.0.0.0.
REPORTGEN_HOST=127.0.0.1
REPORTGEN_PORT=8080

# Выключать аутентификацию можно только на одиночной рабочей станции:
# в кейсах лежат данные заказчиков (docs/09 р. 9.2, docs/07).
REPORTGEN_AUTH_ENABLED=true

# Время жизни сессии, ч. 12 — рабочий день.
REPORTGEN_SESSION_TTL_HOURS=12

# Потолок размера загружаемого файла, МБ. Должен совпадать с
# client_max_body_size в deploy/nginx.conf, иначе nginx вернёт 413 раньше
# приложения и инженер не увидит внятной ошибки.
REPORTGEN_MAX_UPLOAD_MB=200

# Ключ подписи cookie-сессий. ОБЯЗАТЕЛЬНО задайте свой:
#     openssl rand -hex 32
# Смена ключа закрывает все активные сессии. В систему контроля версий не
# попадает — этот файл только образец.
REPORTGEN_SECRET_KEY=
