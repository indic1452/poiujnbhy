# Адрес бэкенда (пусто = относительные пути через vite-proxy/nginx)
# VITE_API_BASE=http://localhost:8000

# Тайлы карты. По умолчанию — OpenStreetMap (для личного/dev использования).
# Для продакшена возьмите ключ у CARTO/MapTiler/Stadia и укажите их шаблон URL,
# либо разверните офлайн-тайлы (PMTiles). {z}/{x}/{y} — обязательны.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
